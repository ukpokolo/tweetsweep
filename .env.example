# Postgres (matches docker-compose.yml)
DATABASE_URL="postgresql://tweetsweep:tweetsweep@localhost:5432/tweetsweep"

# Redis (BullMQ delete queue)
REDIS_URL="redis://localhost:6379"

# X developer app (OAuth 2.0 with PKCE)
X_CLIENT_ID=""
X_CLIENT_SECRET=""
X_REDIRECT_URI="http://localhost:3000/api/auth/x/callback"

# 32 random bytes, base64. Generate: openssl rand -base64 32
# Encrypts OAuth tokens and stored tweet text.
ENCRYPTION_KEY=""

# Signs session cookies. Generate: openssl rand -base64 32
SESSION_SECRET=""

# Days stored tweet text is kept before being purged
TWEET_RETENTION_DAYS="30"

# Embeddings (used from step 3)
VOYAGE_API_KEY=""

# Classification (used from step 4)
ANTHROPIC_API_KEY=""
